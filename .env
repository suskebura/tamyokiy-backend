# ============================================================
# 🧠 AUTO-ASSIGNMENT CONFIGURATION
# ============================================================

# Enable auto-assignment when new shipment is created
AUTO_ASSIGN_ON_NEW=true

# Minimum driver score to accept assignment (0-100)
AUTO_ASSIGN_MIN_SCORE=30

# Max shipments per driver (default vehicle capacity)
AUTO_ASSIGN_MAX_LOAD=5

# Enable proximity-based scoring
AUTO_ASSIGN_USE_PROXIMITY=true

# Enable driver rating scoring
AUTO_ASSIGN_USE_RATING=true

# Enable vehicle matching
AUTO_ASSIGN_USE_VEHICLE_MATCH=true

# Assignment algorithm weights (total should equal 100)
AUTO_ASSIGN_WEIGHT_PROXIMITY=35
AUTO_ASSIGN_WEIGHT_LOAD=25
AUTO_ASSIGN_WEIGHT_RATING=20
AUTO_ASSIGN_WEIGHT_VEHICLE=20

# ============================================================
# 📍 LOCATION SERVICES
# ============================================================

# Max distance in km for proximity scoring (drivers beyond this get 0)
AUTO_ASSIGN_MAX_DISTANCE=50

# OSRM API endpoint for distance calculation
OSRM_API_URL=https://router.project-osrm.org

# ============================================================
# 📬 NOTIFICATION SETTINGS
# ============================================================

# Send notifications on assignment
AUTO_ASSIGN_NOTIFY_DRIVER=true
AUTO_ASSIGN_NOTIFY_CUSTOMER=true

# ============================================================
# 🚨 ANOMALY DETECTION SETTINGS
# ============================================================

# Enable real-time anomaly detection on status changes
ANOMALY_REAL_TIME_ENABLED=true

# Run anomaly detection scan every X hours (cron schedule: '0 */6 * * *')
ANOMALY_SCAN_SCHEDULE=0 */6 * * *

# Severity threshold for auto-blocking drivers (critical/high)
AUTO_BLOCK_THRESHOLD=3

# Auto-block drivers with X confirmed critical/high anomalies
AUTO_BLOCK_CONFIRMED_COUNT=3

# Driver risk score calculation weights
RISK_WEIGHT_DRIVER_HISTORY=30
RISK_WEIGHT_TIME_PATTERN=20
RISK_WEIGHT_CUSTOMER_HISTORY=15
RISK_WEIGHT_GEOGRAPHIC=15
RISK_WEIGHT_RECENT_ACTIVITY=10
RISK_WEIGHT_ANOMALY_TYPE=10

# ============================================================
# 📊 AI RISK SCORING
# ============================================================

# Confidence thresholds
RISK_CONFIDENCE_HIGH=70
RISK_CONFIDENCE_MEDIUM=40

# Driver history thresholds
DRIVER_FAILURE_RATE_HIGH=30
DRIVER_FAILURE_RATE_MODERATE=20
DRIVER_RATING_LOW=3

# Customer history thresholds
CUSTOMER_FAILURE_COUNT_HIGH=3
CUSTOMER_FAILURE_COUNT_MODERATE=1

# Distance thresholds (km)
DISTANCE_VERY_LONG=50
DISTANCE_LONG=30

# Daily delivery volume thresholds
DAILY_DELIVERY_HIGH=20
DAILY_DELIVERY_MODERATE=15

# ============================================================
# 📧 EMAIL ALERT CONFIGURATION
# ============================================================

# Send email alerts for anomalies
ANOMALY_EMAIL_ENABLED=true

# Only send email for severity levels: critical, high, medium
ANOMALY_EMAIL_MIN_SEVERITY=high

# Weekly summary email
WEEKLY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_SCHEDULE=0 8 * * 1  # Monday 8am

# ============================================================
# 🔄 SENTIMENT ANALYSIS CONFIGURATION
# ============================================================

# Enable auto-sentiment analysis on tickets
SENTIMENT_AUTO_ANALYZE_TICKETS=true

# Enable auto-sentiment analysis on ratings
SENTIMENT_AUTO_ANALYZE_RATINGS=true

# Auto-escalate tickets based on sentiment
SENTIMENT_AUTO_ESCALATE=true

# Minimum confidence for auto-escalation
SENTIMENT_MIN_CONFIDENCE=60

# ============================================================
# 📊 WAREHOUSE FORECAST CONFIGURATION
# ============================================================

# Enable daily forecast generation
FORECAST_ENABLED=true

# Forecast period (daily, weekly, monthly)
FORECAST_PERIOD=monthly

# Number of months to forecast ahead
